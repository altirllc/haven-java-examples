# Published ports for docker-compose.yml. Copy to .env and remap when the host
# already serves something on a default port.
#
# The values below are in use on rc-server, which already runs PostgreSQL 16 on
# 5432, MongoDB 8.0 on 27017, Redis on 6379 and Open WebUI on 18080 — and the
# plumb stand on 15432 / 27018 / 7233 / 8233 / 8333.
LOOM_POSTGRES_PORT=15433
LOOM_MONGO_PORT=27019
LOOM_TEMPORAL_PORT=17233
LOOM_TEMPORAL_UI_PORT=18234
LOOM_S3_PORT=18333
LOOM_BROKER_PORT=18001
LOOM_EVENTS_PORT=18008
LOOM_NOTIFICATIONS_PORT=18089
LOOM_VALKEY_PORT=16379

# The tenant bucket, created by seaweedfs-init.
LOOM_BUCKET=haven-local

# Image tags. `latest` is what the dispatch bundle deploys, and for events-api
# and events-broker it is the only moving tag published at all.
BROKER_TAG=latest
EVENTS_TAG=latest
NOTIFICATIONS_TAG=latest

# ---------------------------------------------------------------- demo profile
#
# Everything below matters only under `docker compose --profile demo up -d`,
# which runs Anvil and loom themselves rather than just the services they need.

# REQUIRED. The one credential the demo cannot supply for itself. It goes to
# LiteLLM and nowhere else: neither app ever sees a provider key, exactly as in
# a cell, where the tenant holds a virtual key instead. Both apps fail-fast
# without a reachable gateway, so a missing value stops the stack at startup
# rather than at the first request.
OPENAI_API_KEY=

# The virtual key the apps authenticate to the gateway with. Stands in for the
# tenant's key from tenant-models-secret; any string will do locally.
LITELLM_MASTER_KEY=sk-loom-local

# Where the demo is served. One port for everything, because there is one edge:
#   http://localhost:8088/loom/    the supervisor
#   http://localhost:8088/anvil/   the app it supervises
LOOM_EDGE_PORT=18088
LOOM_MODELS_PORT=14000

# Which images to run. GHCR_OWNER is the org the six app images were pushed to.
GHCR_OWNER=altirllc
ANVIL_TAG=latest
LOOM_TAG=latest

# Demo pacing. A cell would use 24h and 60s; these are set so a case can be
# opened, reviewed and left to lapse inside one sitting.
LOOM_CASE_SLA=10m
LOOM_AGENT_INTERVAL=60s
LOOM_INGEST_INTERVAL=30s
ANVIL_AGENT_INTERVAL=30s

# Plan allowances. Left on `free` so the metering gate is visible, raised from
# the shipped default of 10 so it is not the first thing the demo hits.
LOOM_PLAN=free
LOOM_PLAN_FREE_CASES=25
ANVIL_PLAN=free
ANVIL_PLAN_FREE_ITEMS=25

# ------------------------------------------------- Dispatch stack credentials
#
# Local-only values for the events/notifications containers. They have working
# defaults, so the stack runs without this block — it is here so the knobs are
# visible rather than buried in the compose file. None of them is a real secret
# and none is used by loom itself; in a cell these come from tenant secrets.
EVENTS_CONFIG_SECRET_KEY=dev-config-key-change-me
EVENTS_SYNC_SECRET_KEY=dev-sync-key-change-me
TENANCY_SYNC_KEY=loom-local-sync-key
TENANT_MGMT_SECRET=dev-tenant-secret-change-me
NOTIFICATIONS_ADMIN_PASSWORD=1111
# fn-notifications' OWN access key as an events-api customer
# (`notification-service`). Unrelated to loom's DISPATCH_ACCESS_KEY, which is a
# different customer — and in default-tenant mode every topic is key-less, so
# neither is enforced.
CUSTOMER_ACCESS_KEY=loomLocalKey123
