<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>haven.loom</groupId>
    <artifactId>loom</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>orchestration</artifactId>

  <!-- The Temporal CLIENT side: connecting, starting workflows, sending
       signals.

       This exists as its own module because contracts cannot hold it. contracts
       is on workflows' compile classpath, so a Spring or Temporal-client
       dependency there would land inside the fence. Keeping the client here
       lets api, agent and jobs share one WorkflowClient without widening what
       workflows can see. -->
  <dependencies>
    <dependency>
      <groupId>haven.loom</groupId>
      <artifactId>domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>haven.loom</groupId>
      <artifactId>contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-sdk</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
