# Published ports for docker-compose.yml. Copy to .env and edit only when the
# host already serves something on a default port.
#
# The values below are the ones in use on rc-server (192.168.1.100), whose
# native PostgreSQL 16 and MongoDB 8.0 already own 5432 and 27017. They pair
# with the `rc` Spring profile; see README.
PLUMB_POSTGRES_PORT=15432
PLUMB_MONGO_PORT=27018
PLUMB_NEO4J_PORT=7688
PLUMB_VALKEY_PORT=6380
PLUMB_TEMPORAL_PORT=7233
PLUMB_TEMPORAL_UI_PORT=8233
PLUMB_S3_PORT=8333

# The model gateway is opt-in: `docker compose --profile models up -d`.
# LITELLM_MASTER_KEY is what plumb sends as MODELS_GATEWAY_API_KEY; in a cell
# that value is the tenant's virtual key from tenant-models-secret.
PLUMB_MODELS_PORT=4000
OPENAI_API_KEY=
LITELLM_MASTER_KEY=sk-plumb-local

# The tenant bucket, created by seaweedfs-init.
PLUMB_BUCKET=haven-local
